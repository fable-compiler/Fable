{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary",
                "src/Fable.Cli"
            ],
            "group": "build",
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build fable-library - JavaScript",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "src/Fickl.Build",
                "--",
                "fable-library",
                "javascript"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build fable-library - TypeScript",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "src/Fickl.Build",
                "--",
                "fable-library",
                "typescript"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build fable-library - Python",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "src/Fickl.Build",
                "--",
                "fable-library",
                "python"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build fable-library - Dart",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "src/Fickl.Build",
                "--",
                "fable-library",
                "dart"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build fable-library - Rust",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "src/Fickl.Build",
                "--",
                "fable-library",
                "rust"
            ],
            "problemMatcher": []
        },
        {
            "label": "build bench-compiler",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary",
                "src/fable-standalone/test/bench-compiler/src"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish bench-compiler",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary",
                "src/fable-standalone/test/bench-compiler/src",
                "--configuration",
                "Debug",
                "--runtime",
                "linux-x64"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build Rust.AST.Tests",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary",
                "src/Fable.Transforms/Rust/AST/Tests"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
