<Project>
    <!--
        Fickl package identity. Every Fickl-specific NuGet override lives here so upstream
        Fable project files stay untouched; src/Directory.Build.targets imports this file.
        Namespaces and assembly names are deliberately left as Fable.* to keep upstream merges cheap.
    -->
    <PropertyGroup>
        <FicklVersion>0.5.3</FicklVersion>
        <PackageProjectUrl>https://github.com/shayanhabibi/fickl</PackageProjectUrl>
        <RepositoryUrl>https://github.com/shayanhabibi/fickl.git</RepositoryUrl>
        <PackageTags>fsharp;fickl;fable;javascript;typescript;python;f#;js</PackageTags>
        <Authors>Alfonso García-Caro Núñez;Fable contributors;Fickl contributors</Authors>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Fable.Cli'">
        <PackageId>Fickl</PackageId>
        <ToolCommandName>fickl</ToolCommandName>
        <Description>Fickl: a performance-focused fork of the Fable F# compiler</Description>
        <!-- Fickl's own version; the CHANGELOG version EasyBuild would set is Fable's -->
        <EasyBuildPackageReleaseNotes_DisableSetVersion>true</EasyBuildPackageReleaseNotes_DisableSetVersion>
        <Version>$(FicklVersion)</Version>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Fable.Cli' OR '$(MSBuildProjectName)' == 'Fickl.Core' OR '$(MSBuildProjectName)' == 'Fable.AST' OR '$(MSBuildProjectName)' == 'Fable.Compiler' OR '$(MSBuildProjectName)' == 'Fable.PublishUtils'">
        <!-- Keep upstream assembly versions for binary plugin compatibility. -->
        <PackageVersion>$(FicklVersion)</PackageVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Fickl.Core'">
        <PackageId>Fickl.Core</PackageId>
    </PropertyGroup>

    <!-- EasyBuild assigns both Version and PackageVersion from upstream changelogs during the build. -->
    <Target Name="FicklRestorePackageVersion" AfterTargets="SetVersionFromCurrentRelease"
        Condition="'$(MSBuildProjectName)' == 'Fable.Cli' OR '$(MSBuildProjectName)' == 'Fickl.Core' OR '$(MSBuildProjectName)' == 'Fable.AST' OR '$(MSBuildProjectName)' == 'Fable.Compiler' OR '$(MSBuildProjectName)' == 'Fable.PublishUtils'">
        <PropertyGroup>
            <PackageVersion>$(FicklVersion)</PackageVersion>
        </PropertyGroup>
    </Target>

    <!--
        Tool packages per runtime, each one ReadyToRun-compiled as a single composite image, plus a portable `any`
        package for other platforms; the SDK installs the one matching the machine (.NET SDK 10+).
        Only `dotnet pack` sets _IsPacking, so builds and tests keep the plain IL output.
    -->
    <!--
        Hot ReadyToRun methods otherwise pass through an instrumented tier before the optimised one, which on
        compiler workloads costs more than the profile gains (see notes/perf-frontiers.md).
    -->
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Fable.Cli'">
        <TieredPGO>false</TieredPGO>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Fable.Cli' AND '$(_IsPacking)' == 'true'">
        <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;osx-x64;osx-arm64;any</RuntimeIdentifiers>
        <ToolPackageRuntimeIdentifiers>$(RuntimeIdentifiers)</ToolPackageRuntimeIdentifiers>
        <SelfContained>false</SelfContained>
    </PropertyGroup>

    <PropertyGroup
        Condition="'$(MSBuildProjectName)' == 'Fable.Cli' AND '$(_IsPacking)' == 'true' AND '$(RuntimeIdentifier)' != '' AND '$(RuntimeIdentifier)' != 'any'">
        <PublishReadyToRun>true</PublishReadyToRun>
    </PropertyGroup>

    <!-- The pointer package holds no assemblies, so it has no symbols package either -->
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Fable.Cli' AND '$(_IsPacking)' == 'true' AND '$(RuntimeIdentifier)' == ''">
        <IncludeSymbols>false</IncludeSymbols>
    </PropertyGroup>

    <!--
        One composite image of the app's own assemblies lets crossgen inline FSharp.Core into FCS and Fable. The SDK
        turns composite off for framework-dependent apps at evaluation time, so it is set again here; the framework
        stays outside the composite, and an image the runtime rejects falls back to the JIT.
    -->
    <Target Name="FicklReadyToRunComposite" BeforeTargets="_PrepareForReadyToRunCompilation"
        Condition="'$(MSBuildProjectName)' == 'Fable.Cli' AND '$(PublishReadyToRun)' == 'true'">
        <PropertyGroup>
            <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
        </PropertyGroup>
    </Target>

    <!-- Fable.Cli sets GenerateAssemblyInfo=false, so the Fickl version reaches the code as a generated module -->
    <Target Name="FicklWriteVersion" BeforeTargets="CoreCompile" Condition="'$(MSBuildProjectName)' == 'Fable.Cli'">
        <PropertyGroup>
            <FicklVersionFile>$(IntermediateOutputPath)Fickl.Version.fs</FicklVersionFile>
        </PropertyGroup>
        <WriteLinesToFile
            File="$(FicklVersionFile)"
            Lines="module internal Fickl.Version;let VERSION = &quot;$(Version)&quot;"
            Overwrite="true"
            WriteOnlyWhenDifferent="true" />
        <ItemGroup>
            <_FicklCompile Include="@(Compile)" />
            <Compile Remove="@(Compile)" />
            <Compile Include="$(FicklVersionFile);@(_FicklCompile)" />
            <FileWrites Include="$(FicklVersionFile)" />
        </ItemGroup>
    </Target>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Fable.Compiler'">
        <PackageId>Fickl.Compiler</PackageId>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Fable.AST'">
        <PackageId>Fickl.AST</PackageId>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Fable.PublishUtils'">
        <PackageId>Fickl.PublishUtils</PackageId>
    </PropertyGroup>
</Project>
