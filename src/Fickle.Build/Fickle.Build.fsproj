<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Forwarded.fs" />
    <Compile Include="Fickle.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Upstream's build commands run in-process through Build.Main.main, untouched -->
    <ProjectReference Include="../Fable.Build/Fable.Build.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Partas.Build" Version="0.8.2" />
    <PackageReference Include="Partas.Build.Baked" Version="0.3.0" />
    <!-- Partas.Build needs a newer FSharp.Core than the SDK's implicit one -->
    <PackageReference Update="FSharp.Core" Version="10.1.402" />
  </ItemGroup>
</Project>
