<Project>
    <!--
        Fickle package identity. Every Fickle-specific NuGet override lives here so upstream
        Fable project files stay untouched; src/Directory.Build.targets imports this file.
        Namespaces and assembly names are deliberately left as Fable.* to keep upstream merges cheap.
    -->
    <PropertyGroup>
        <PackageProjectUrl>https://github.com/shayanhabibi/fickle</PackageProjectUrl>
        <RepositoryUrl>https://github.com/shayanhabibi/fickle.git</RepositoryUrl>
        <PackageTags>fsharp;fickle;fable;javascript;typescript;python;f#;js</PackageTags>
        <Authors>Alfonso García-Caro Núñez;Fable contributors;Fickle contributors</Authors>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Fable.Cli'">
        <PackageId>fickle-tool</PackageId>
        <ToolCommandName>fickle</ToolCommandName>
        <Description>Fickle: a performance-focused fork of the Fable F# compiler</Description>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Fable.Compiler'">
        <PackageId>Fickle.Compiler</PackageId>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Fable.AST'">
        <PackageId>Fickle.AST</PackageId>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Fable.PublishUtils'">
        <PackageId>Fickle.PublishUtils</PackageId>
    </PropertyGroup>
</Project>
