-            | _ -> { Caches.CacheOptions.getDefault HashIdentity.Structural with TotalCapacity = 65536; HeadroomPercentage = 75 }
+            | CompilationMode.OneOff -> Caches.CacheOptions.getDefault typeCacheKeyComparer |> Caches.CacheOptions.withNoEviction
+            | _ -> { Caches.CacheOptions.getDefault typeCacheKeyComparer with TotalCapacity = 65536; HeadroomPercentage = 75 }
