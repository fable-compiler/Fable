+// Keep the structural cache-key contract while avoiding Array.GetValue boxing for
+// the TypeToken vectors. This comparer is private to this cache; arbitrary arrays
+// and user-supplied comparers continue to use the ordinary Core implementation.
+let private typeTokenArrayComparer =
+    let tokenComparer = HashIdentity.Structural<TypeToken>
+    { new System.Collections.IEqualityComparer with
+        member this.Equals(x, y) =
+            match x, y with
+            | (:? (TypeToken[]) as xs), (:? (TypeToken[]) as ys) ->
+                let mutable equal = xs.Length = ys.Length
+                let mutable i = 0
+                while equal && i < xs.Length do
+                    equal <- tokenComparer.Equals(xs[i], ys[i])
+                    i <- i + 1
+                equal
+            | null, _ -> isNull y
+            | _, null -> false
+            | (:? System.Collections.IStructuralEquatable as value), _ -> value.Equals(y, this)
+            | _ -> LanguagePrimitives.GenericEqualityComparer.Equals(x, y)
+        member this.GetHashCode(x) =
+            match x with
+            | :? (TypeToken[]) as tokens ->
+                // Core's one-dimensional array hash visits indices min(length-1,18)
+                // down to zero, even for arrays longer than the hashed prefix.
+                let mutable i = min (tokens.Length - 1) 18
+                let mutable acc = 0
+                while i >= 0 do
+                    acc <- (acc <<< 1) + tokenComparer.GetHashCode(tokens[i]) + 631 * i
+                    i <- i - 1
+                acc
+            | null -> 0
+            | :? System.Collections.IStructuralEquatable as value -> value.GetHashCode(this)
+            | _ -> LanguagePrimitives.GenericEqualityComparer.GetHashCode(x) }
+
+let private typeCacheKeyComparer =
+    { new System.Collections.Generic.IEqualityComparer<TTypeCacheKey> with
+        member _.Equals(x, y) =
+            (x :> System.Collections.IStructuralEquatable).Equals(y, typeTokenArrayComparer)
+        member _.GetHashCode(x) =
+            (x :> System.Collections.IStructuralEquatable).GetHashCode(typeTokenArrayComparer) }
+
 let getTypeSubsumptionCache =
